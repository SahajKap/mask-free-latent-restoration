+
+# ---------------------------------------------------------------------------
+# Added for MaskFreeLDM: T1 evaluation sets (ATLAS v2, WMH).
+# Same structure as Brats21/MSLUB above; images are already T1, so no path
+# rewriting is needed. Split CSVs are set in configs/datamodule/IXI.yaml under
+# path.ATLAS_v2.IDs.{val,test} and path.WMH.IDs.{val,test}.
+# ---------------------------------------------------------------------------
+
+class _EvalSet(LightningDataModule):
+    setname = None
+
+    def __init__(self, cfg, fold=None):
+        super().__init__()
+        self.cfg = cfg
+        self.preload = cfg.get('preload', True)
+        p = cfg.path[self.setname]
+        self.csv = {'val': pd.read_csv(p.IDs.val), 'test': pd.read_csv(p.IDs.test)}
+        for state in ['val', 'test']:
+            self.csv[state]['settype'] = state
+            self.csv[state]['setname'] = self.setname
+            for col in ['img_path', 'mask_path', 'seg_path']:
+                self.csv[state][col] = cfg.path.pathBase + '/Data/' + self.csv[state][col]
+
+    def setup(self, stage: Optional[str] = None):
+        if not hasattr(self, 'val_eval'):
+            n = 4 if self.cfg.sample_set else None
+            self.val_eval = create_dataset.Eval(self.csv['val'][0:n], self.cfg)
+            self.test_eval = create_dataset.Eval(self.csv['test'][0:n], self.cfg)
+
+    def val_dataloader(self):
+        return DataLoader(self.val_eval, batch_size=1, num_workers=self.cfg.num_workers, pin_memory=False, shuffle=False)
+
+    def test_dataloader(self):
+        return DataLoader(self.test_eval, batch_size=1, num_workers=self.cfg.num_workers, pin_memory=False, shuffle=False)
+
+
+class ATLAS_v2(_EvalSet):
+    setname = 'ATLAS_v2'
+
+
+class WMH(_EvalSet):
+    setname = 'WMH'
